# Normalize all text files to LF in the repository.
# Prevents whole-file CRLF/LF churn in diffs regardless of editor or OS.
* text=auto eol=lf

# Be explicit for the file types in this repo.
*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
